<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/ArctraWin.App/Catalog/SatelliteCatalog.cs" Link="SatelliteCatalog.cs" />
    <Compile Include="../../src/ArctraWin.App/Observer/*.cs" Link="Observer/%(Filename)%(Extension)" />
    <Compile Include="../../src/ArctraWin.App/Live/*.cs" Link="Live/%(Filename)%(Extension)" />
    <None Include="../../assets/catalog/edc-active-satellites.csv" Link="catalog.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
